			"id": "e73db34c-ad89-5dec-a97f-e98541c5d497",
			"name": "Read contact rows",
			"type": "n8n-nodes-base.googleSheets",
			"typeVersion": 4.6,
			"position": [1060, 160]
		},
		{
			"parameters": {
				"conditions": {
					"options": {
						"caseSensitive": true,
						"leftValue": "",
						"typeValidation": "strict",
						"version": 2
					},
					"conditions": [

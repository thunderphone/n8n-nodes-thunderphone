							"id": "727e3a75-59d2-5cad-855e-9437adb8425d",
							"leftValue": "={{ String($json.phone_number ?? '').trim() }}",
							"rightValue": "",
							"operator": {
								"type": "string",
								"operation": "notEmpty",
								"singleValue": true
